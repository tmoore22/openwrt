From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim <mooretim4@gmail.com>
Date: Mon, 2 Nov 2026 23:15:02 +0100
Subject: [PATCH] mtd: spi-nor: add Zbit ZB25VQ128 with SR locking

The ZB25VQ128 (JEDEC 5e 40 18) on the Orange Pi Zero3 currently binds as
spi-nor-generic, which has no locking ops. Block-protect bits left set by
the vendor image can therefore neither be queried nor cleared, and erase
or program to a protected range is silently ignored, which shows up as
JFFS2 CRC and magic-bitmask errors.

Add a manufacturer entry that keeps the SFDP-only init path of the generic
fallback (size left 0) and only adds W25Q128-style SR locking, plus a
one-shot dump of SR1/SR2 at probe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WZsJjhtUYg72cfVriiuE5L
---
 drivers/mtd/spi-nor/Makefile |  1 +
 drivers/mtd/spi-nor/core.c   |  1 +
 drivers/mtd/spi-nor/core.h   |  1 +
 drivers/mtd/spi-nor/zbit.c   | 59 ++++++++++++++++++++++++++++++++++++
 4 files changed, 62 insertions(+)
 create mode 100644 drivers/mtd/spi-nor/zbit.c

diff --git a/drivers/mtd/spi-nor/Makefile b/drivers/mtd/spi-nor/Makefile
index 1072cf609..23067a379 100644
--- a/drivers/mtd/spi-nor/Makefile
+++ b/drivers/mtd/spi-nor/Makefile
@@ -15,6 +15,7 @@ spi-nor-objs			+= sst.o
 spi-nor-objs			+= winbond.o
 spi-nor-objs			+= xmc.o
 spi-nor-objs			+= xtx.o
+spi-nor-objs			+= zbit.o
 spi-nor-$(CONFIG_DEBUG_FS)	+= debugfs.o
 obj-$(CONFIG_MTD_SPI_NOR)	+= spi-nor.o
 
diff --git a/drivers/mtd/spi-nor/core.c b/drivers/mtd/spi-nor/core.c
index e7d544372..bc1bfe10f 100644
--- a/drivers/mtd/spi-nor/core.c
+++ b/drivers/mtd/spi-nor/core.c
@@ -1957,6 +1957,7 @@ static const struct spi_nor_manufacturer *manufacturers[] = {
 	&spi_nor_winbond,
 	&spi_nor_xmc,
 	&spi_nor_xtx,
+	&spi_nor_zbit,
 };
 
 static const struct flash_info spi_nor_generic_flash = {
diff --git a/drivers/mtd/spi-nor/core.h b/drivers/mtd/spi-nor/core.h
index b8a43fce5..15f45112b 100644
--- a/drivers/mtd/spi-nor/core.h
+++ b/drivers/mtd/spi-nor/core.h
@@ -605,6 +605,7 @@ extern const struct spi_nor_manufacturer spi_nor_sst;
 extern const struct spi_nor_manufacturer spi_nor_winbond;
 extern const struct spi_nor_manufacturer spi_nor_xmc;
 extern const struct spi_nor_manufacturer spi_nor_xtx;
+extern const struct spi_nor_manufacturer spi_nor_zbit;
 
 extern const struct attribute_group *spi_nor_sysfs_groups[];
 
diff --git a/drivers/mtd/spi-nor/zbit.c b/drivers/mtd/spi-nor/zbit.c
new file mode 100644
index 000000000..ccfe2be77
--- /dev/null
+++ b/drivers/mtd/spi-nor/zbit.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Zbit Semiconductor SPI NOR flashes.
+ *
+ * Without an entry here the ZB25VQ128 binds as "spi-nor-generic", which has
+ * no locking ops: the block-protect bits can then neither be queried nor
+ * cleared, and erase/program to a protected range is silently ignored.
+ */
+
+#include <linux/mtd/spi-nor.h>
+
+#include "core.h"
+
+/* Log SR1/SR2 once at probe so the protection state is visible in dmesg. */
+static int zbit_nor_late_init(struct spi_nor *nor)
+{
+	u8 *buf = nor->bouncebuf;
+	u8 sr1, sr2;
+
+	if (spi_nor_read_sr(nor, buf))
+		return 0;
+	sr1 = buf[0];
+
+	if (spi_nor_read_cr(nor, buf))
+		return 0;
+	sr2 = buf[0];
+
+	dev_info(nor->dev,
+		 "zbit: SR1=0x%02x SR2=0x%02x (BP=%u TB=%u SEC=%u SRP0=%u SRP1=%u QE=%u CMP=%u)\n",
+		 sr1, sr2, (sr1 >> 2) & 0x7, !!(sr1 & BIT(5)), !!(sr1 & BIT(6)),
+		 !!(sr1 & BIT(7)), !!(sr2 & BIT(0)), !!(sr2 & BIT(1)),
+		 !!(sr2 & BIT(6)));
+
+	return 0;
+}
+
+static const struct spi_nor_fixups zbit_nor_fixups = {
+	.late_init = zbit_nor_late_init,
+};
+
+static const struct flash_info zbit_nor_parts[] = {
+	{
+		/*
+		 * .size left 0 on purpose: geometry and read/erase opcodes come
+		 * from SFDP exactly as with the generic fallback. Only the
+		 * W25Q128-style SR locking is added.
+		 */
+		.id = SNOR_ID(0x5e, 0x40, 0x18),
+		.name = "zb25vq128",
+		.flags = SPI_NOR_HAS_LOCK | SPI_NOR_HAS_TB,
+		.fixups = &zbit_nor_fixups,
+	},
+};
+
+const struct spi_nor_manufacturer spi_nor_zbit = {
+	.name = "zbit",
+	.parts = zbit_nor_parts,
+	.nparts = ARRAY_SIZE(zbit_nor_parts),
+};
